---
import { Icon } from "astro-icon/components";

interface Props {
    url: string;
    title: string;
}
let { url, title }: Props = Astro.props;
---

<a
    class="group flex items-center hover:opacity-60 duration-150 cursor-pointer"
    href={url}
    rel="noopener"
    target="_blank"
>
    {title}
    <Icon
        name="arrow-up-right"
        aria-hidden="true"
        class="duration-200 group-hover:translate-x-[1.5px] w-4 h-4 shrink-0"
    />
</a>
