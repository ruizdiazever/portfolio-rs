---
import Layout from "$lib/layouts/Layout.astro";
import * as m from "@paraglide/messages.js";
import { Icon } from "astro-icon/components";
---

<Layout title={m.titleCv()} description={m.seoAbout()}>
    <div class="mt-10 max-w-[60ch] space-y-4">
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
            {m.cv()}
        </h1>
        <p class="text-lg text-secondary-foreground">{m.cvIntro()}</p>
        <a
            href="https://www.linkedin.com/in/everdev/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-medium text-blue-600 underline decoration-2 decoration-blue-600/30 underline-offset-4 hover:text-blue-500 dark:text-blue-400 dark:decoration-blue-400/30 dark:hover:text-blue-300"
        >
            LinkedIn
            <Icon
                name="arrow-right"
                aria-hidden="true"
                class="h-4 w-4"
            />
        </a>
        <p class="pt-6 text-sm">
            <a href="/" class="text-muted-foreground hover:text-foreground">
                ← {m.goHome()}
            </a>
        </p>
    </div>
</Layout>
