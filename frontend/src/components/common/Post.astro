---
import { Icon } from "astro-icon/components";
import { getLocale } from "@paraglide/runtime";
import Media from "$lib/components/common/Media.astro";
import Feedback from "$lib/components/common/feedback.svelte";
import { formatMonth } from "$lib/common/formatDate";
import Toast from "$lib/components/common/toast.svelte";
import { postVisitRequest } from "$lib/common/postView.ts";
import { getVisitRequest } from "$lib/common/getViews.ts";
import * as m from "@paraglide/messages.js";

interface Props {
    id: string;
    title: string;
    url: string;
    description: string;
    readTime: number;
    author: string[];
    tags: string[];
    date: Date;
}

let { id, title, description, readTime, tags, date, author }: Props =
    Astro.props;

await postVisitRequest(id);
let views = await getVisitRequest(id);
---

<div class="relative mx-auto blog mt-10 w-full min-w-0 max-w-full">
    <div
        id="back-button"
        inert
        class="fixed bottom-4 left-1/2 opacity-0 transition-[opacity,transform] duration-200 ease-out translate-y-10
        lg:top-36 lg:left-8 lg:ml-10"
    >
        <a
            href="/"
            rel="external"
            class="group border inline-flex h-10 items-center justify-center
        rounded-full px-4 text-sm bg-background text-foreground
        transition-colors hover:bg-muted focus-visible:outline-none
        focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none
        disabled:opacity-50 gap-1 z-20"
        >
            <Icon
                class="duration-150 group-hover:translate-x-[-2.5px] text-foreground"
                name="chevron-left"
                aria-hidden="true"
                size="1rem"
            />
            <p class="text-sm text-foreground">
                {m.back()}
            </p>
        </a>
    </div>
    <article class="text-card-foreground">
        <div class="flex items-center justify-center mb-2 md:mb-3">
            <div class="w-full text-center">
                <div
                    class="flex items-center justify-center gap-2 text-card-foreground"
                >
                    <p class="flex md:gap-1 text-sm text-muted-foreground tabular-nums">
                        {readTime}
                        {getLocale() === "zh" ? "分钟阅读" : "min read"}
                    </p>
                    <Icon name="timer" aria-hidden="true" size="0.8rem" />
                </div>
                <h1 class="text-3xl font-medium tracking-[-0.022em] text-foreground md:text-4xl">
                    {title}
                </h1>
            </div>
        </div>
        <div class="space-y-2 not-prose text-center">
            <p class="text-base text-pretty md:text-lg">{description}</p>
            <div
                class="flex flex-wrap justify-center items-center gap-x-4 gap-y-1 text-sm text-muted-foreground"
            >
                <div class="flex items-center justify-center gap-1 flex-wrap font-medium">
                    <Icon name="timer" aria-hidden="true" size="0.8rem" />
                    <span class="tabular-nums">
                        {formatMonth(date)}
                    </span>
                </div>
                <div
                    class="flex items-center justify-center gap-1 flex-wrap font-medium"
                    title={tags.join(", ")}
                >
                    <Icon name="tag" aria-hidden="true" size="0.8rem" />
                    <span class="tabular-nums">{tags.length} {m.tags()}</span>
                </div>
                <div class="flex items-center justify-center">
                    <span
                        class="flex items-center justify-center gap-1 flex-wrap font-medium"
                    >
                        <Icon name="eye" aria-hidden="true" size="0.8rem" />

                        <span
                            class="tabular-nums"
                        >
                            {views.visits}
                        </span>
                        {views.visits === 1 ? m.viewSingular() : m.views()}
                    </span>
                </div>
            </div>
            <p class="flex flex-wrap items-center justify-center gap-x-1 text-secondary-foreground pt-3">
                <span class="sr-only">{getLocale() === "zh" ? "作者：" : `${m.author()}: `}</span>
                {
                    author.map((name) => (
                        <>
                            <Media
                                path={
                                    name === "Ever Ruiz Diaz"
                                        ? "site/authors/ever"
                                        : "site/authors/maxi"
                                }
                                widths={[44, 88]}
                                width={22}
                                height={22}
                                sizes="22px"
                                alt={name}
                                class="rounded-full"
                            />
                            <span class="ml-1 mr-2">{name}</span>
                        </>
                    ))
                }
            </p>
        </div>
        <hr class="my-8 h-px border-0 bg-border" />
        <div class="mt-6 space-y-4"><slot /></div>
        <Feedback client:idle title={title} {id} language={getLocale()} />
        <Toast client:idle />
    </article>
</div>

<script>
    const backButton = document.getElementById("back-button");

    document
        .querySelectorAll<HTMLTableElement>(".blog-content-table")
        .forEach((table) => {
            if (table.parentElement?.classList.contains("table-scroll")) return;
            const wrapper = document.createElement("div");
            wrapper.className = "table-scroll";
            table.parentElement?.insertBefore(wrapper, table);
            wrapper.appendChild(table);
        });

    if (backButton) {
        const updateBackButton = () => {
            const windowHeight = window.innerHeight;
            const documentHeight = document.documentElement.scrollHeight;
            const scrollTop =
                window.scrollY || document.documentElement.scrollTop;
            const scrollPercentage =
                (scrollTop + windowHeight) / documentHeight;
            const isMobile = window.innerWidth <= 1024;
            const show =
                window.scrollY > 100 &&
                ((isMobile && scrollPercentage < 0.9) || !isMobile);

            backButton.toggleAttribute("inert", !show);
            backButton.style.opacity = show ? "1" : "0";
            backButton.style.transform = show
                ? "translateX(-50%) translateY(0)"
                : "translateX(-50%) translateY(10px)";
        };

        window.addEventListener("scroll", updateBackButton, { passive: true });
        updateBackButton();
    }
</script>
