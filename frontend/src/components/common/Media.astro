---
import { media, mediaSrcSet } from "$lib/common/media";

interface Props {
	path: string;
	alt: string;
	width: number;
	height: number;
	widths?: number[];
	sizes?: string;
	class?: string;
	loading?: "eager" | "lazy";
	decoding?: "async" | "sync" | "auto";
	fetchpriority?: "high" | "low" | "auto";
}

const {
	path,
	alt,
	width,
	height,
	widths,
	sizes = "100vw",
	class: className,
	loading = "lazy",
	decoding = "async",
	fetchpriority,
} = Astro.props;

const avif = widths ? mediaSrcSet(path, widths, "avif") : undefined;
const webp = widths ? mediaSrcSet(path, widths, "webp") : undefined;
const src = media(widths ? `${path}-${widths[0]}.webp` : path);
---

<picture>
	{avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
	{webp && <source type="image/webp" srcset={webp} sizes={sizes} />}
	<img
		src={src}
		srcset={webp}
		sizes={webp ? sizes : undefined}
		alt={alt}
		width={width}
		height={height}
		loading={loading}
		decoding={decoding}
		class={className}
		fetchpriority={fetchpriority}
	/>
</picture>
