---
import { getLocale } from "@paraglide/runtime";
import * as m from "@paraglide/messages.js";
import { getAgentManifest } from "$lib/common/agent";

const locale = getLocale() === "zh" ? "zh" : "en";
const manifest = getAgentManifest(locale);
const feedBase = `/${locale}`;

const surfaces = [
    { label: m.agentLlmstxt(), href: "/llms.txt" },
    { label: m.agentBriefFile(), href: "/agent.md" },
    { label: m.agentManifest(), href: "/agent.json" },
    { label: m.agentFeedRss(), href: `${feedBase}/feed.xml` },
    { label: m.agentSitemap(), href: "/sitemap-index.xml" },
    { label: m.agentRobots(), href: "/robots.txt" },
];
---

<p
    id="agent-mode-announcer"
    class="sr-only"
    role="status"
    aria-live="polite"
></p>

<aside
    id="agent-dock"
    class="agent-dock"
    aria-label={m.agentMode()}
    data-agent-dock
    data-agent-enabled={m.agentEnabled()}
    data-agent-disabled={m.agentDisabled()}
    data-agent-copied={m.agentCopied()}
    data-agent-copy-failed={m.agentCopyFailed()}
>
    <div class="agent-dock-inner">
        <div class="agent-dock-head">
            <div class="flex min-w-0 items-center gap-2">
                <span class="agent-pulse" aria-hidden="true"></span>
                <span class="agent-kicker">
                    {m.agentMode()}<span class="hidden sm:inline"> / {m.agentHandshake()}</span>
                </span>
                <span class="agent-ready">{m.agentReady()}</span>
            </div>
            <button
                type="button"
                class="agent-close"
                aria-label={m.agentClose()}
                data-agent-close
            >
                <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>

        <div class="agent-dock-body">
            <section class="agent-profile" aria-labelledby="agent-profile-title">
                <p class="agent-eyebrow">{m.agentProfile()}</p>
                <p id="agent-profile-title" class="agent-name">Ever Ruiz Diaz</p>
                <p class="agent-summary">{m.agentProfileSummary()}</p>
                <dl class="agent-receipt">
                    <div>
                        <dt>{m.agentProjectsLabel()}</dt>
                        <dd>{manifest.counts.projects}</dd>
                    </div>
                    <div>
                        <dt>{m.agentNotesLabel()}</dt>
                        <dd>{manifest.counts.writing}</dd>
                    </div>
                    <div>
                        <dt>{m.agentBooksLabel()}</dt>
                        <dd>{manifest.counts.reading}</dd>
                    </div>
                </dl>
                <p class="agent-updated">
                    {m.agentUpdated()} <time datetime={manifest.contentUpdatedAt}>{manifest.contentUpdatedAt}</time>
                </p>
            </section>

            <section aria-labelledby="agent-surfaces-title">
                <div class="agent-section-head">
                    <p id="agent-surfaces-title" class="agent-eyebrow">
                        {m.agentPublicSurfaces()}
                    </p>
                    <span class="agent-count">{String(surfaces.length).padStart(2, "0")}</span>
                </div>
                <ul class="agent-surfaces">
                    {surfaces.map((surface) => (
                        <li>
                            <a href={surface.href}>
                                <span>{surface.label}</span>
                                <svg
                                    class="h-3.5 w-3.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M7 17 17 7M8 7h9v9"></path>
                                </svg>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>

            <section class="agent-handoff" aria-labelledby="agent-handoff-title">
                <p id="agent-handoff-title" class="agent-eyebrow">
                    {m.agentMachineFiles()}
                </p>
                <button type="button" class="agent-copy" data-agent-copy>
                    <svg
                        class="h-4 w-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <rect x="8" y="8" width="11" height="11" rx="2"></rect>
                        <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
                    </svg>
                    <span data-agent-copy-label>{m.agentCopyBrief()}</span>
                </button>
                <a class="agent-contact-link" href={`/${locale}/sections/contact`}>
                    {m.agentContact()}
                    <svg
                        class="h-3.5 w-3.5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M7 17 17 7M8 7h9v9"></path>
                    </svg>
                </a>
                <p class="agent-note">{m.agentNoModel()}</p>
            </section>
        </div>

        <div class="agent-dock-foot">
            <span>{m.agentHumanNote()}</span>
            <span
                id="agent-copy-status"
                class="agent-copy-status"
                role="status"
                aria-live="polite"
            ></span>
        </div>
    </div>
</aside>

<script>
    const root = document.documentElement;
    const toggle = document.querySelector<HTMLButtonElement>("[data-agent-toggle]");
    const close = document.querySelector<HTMLButtonElement>("[data-agent-close]");
    const dock = document.querySelector<HTMLElement>("[data-agent-dock]");
    const announcer = document.getElementById("agent-mode-announcer");
    const copy = document.querySelector<HTMLButtonElement>("[data-agent-copy]");
    const copyLabel = copy?.querySelector<HTMLElement>("[data-agent-copy-label]");
    const copyStatus = document.getElementById("agent-copy-status");
    const storageKey = "portfolio-agent-mode";

    const enabledText = dock?.dataset.agentEnabled ?? "";
    const disabledText = dock?.dataset.agentDisabled ?? "";
    const copiedText = dock?.dataset.agentCopied ?? "";
    const copyFailedText = dock?.dataset.agentCopyFailed ?? "";

    const isEnabled = () => root.classList.contains("agent-mode");

    function syncChrome(enabled: boolean) {
        toggle?.setAttribute("aria-pressed", String(enabled));
        if (announcer) announcer.textContent = enabled ? enabledText : disabledText;
    }

    function syncUrl(enabled: boolean) {
        const url = new URL(window.location.href);
        if (enabled) {
            url.searchParams.set("mode", "agent");
        } else {
            url.searchParams.delete("mode");
        }
        history.replaceState(null, "", url);
    }

    function setMode(enabled: boolean, options: { announce?: boolean; url?: boolean } = {}) {
        root.classList.toggle("agent-mode", enabled);
        try {
            localStorage.setItem(storageKey, enabled ? "agent" : "human");
        } catch {}
        if (options.url !== false) syncUrl(enabled);
        if (options.announce !== false) syncChrome(enabled);
        else toggle?.setAttribute("aria-pressed", String(enabled));
        if (enabled) {
            const reduced = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;
            window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
        }
    }

    toggle?.addEventListener("click", () => setMode(!isEnabled()));
    close?.addEventListener("click", () => {
        setMode(false);
        toggle?.focus();
    });
    toggle?.setAttribute("aria-pressed", String(isEnabled()));

    window.addEventListener("popstate", () => {
        const mode = new URL(window.location.href).searchParams.get("mode");
        if (mode === "agent" || mode === "human") {
            setMode(mode === "agent", { announce: false, url: false });
        }
    });

    copy?.addEventListener("click", async () => {
        if (!copyLabel || !copyStatus) return;
        const original = copyLabel.textContent ?? "";
        try {
            const response = await fetch("/agent.md");
            if (!response.ok) throw new Error("agent brief unavailable");
            const text = await response.text();

            if (!navigator.clipboard?.writeText) {
                throw new Error("clipboard unavailable");
            }
            await navigator.clipboard.writeText(text);

            copyLabel.textContent = copiedText;
            copyStatus.textContent = copiedText;
            window.setTimeout(() => {
                copyLabel.textContent = original;
                copyStatus.textContent = "";
            }, 2500);
        } catch {
            copyStatus.textContent = copyFailedText;
        }
    });
</script>
