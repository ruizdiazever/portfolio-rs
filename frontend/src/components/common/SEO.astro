---
import { getLocale } from "@paraglide/runtime";
import { LOCALE } from "$lib/common/consts";
import { seoConfig } from "$lib/common/seoConfig";
import { media } from "$lib/common/media";
import "$lib/styles/app.css";
import * as m from "@paraglide/messages.js";

interface Props {
    title: string;
    description?: string;
    preloadImgLCP?: string;
    canonical?: string;
    image?: string;
}

const {
    title,
    description = m.seoDefault(),
    preloadImgLCP,
    canonical,
    image,
} = Astro.props;

const pagePath = Astro.url.pathname
    .replace(/^\/(en|zh)(?=\/|$)/, "")
    .replace(/\/+$/, "");
const defaultImage = new URL(
    `/og${pagePath === "" || pagePath === "/" ? "/home" : pagePath}.png`,
    Astro.site,
).href;
const ogImage = image ?? defaultImage;

const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalURL = canonical
    ? new URL(canonical, Astro.site)
    : new URL(canonicalPath, Astro.site);

const localizedHref = (lang: string) => {
    const path = canonicalPath.replace(/^\/(en|zh)(?=\/|$)/, `/${lang}`);
    return new URL(path, Astro.site).href;
};

const LOCALES = ["en", "zh"] as const;

const ogType = Astro.url.pathname.includes("blog") ? "article" : "website";
const personImage = media("site/avatar-192.webp");
const isProfilePage = /^\/(en|zh)\/?$/.test(Astro.url.pathname);
const language = LOCALE[getLocale()];
const personId = new URL("/#person", Astro.site).href;
const websiteId = new URL("/#website", Astro.site).href;
const pageId = `${canonicalURL.href}#webpage`;
const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Person",
            "@id": personId,
            name: "Ever Ruiz Diaz",
            url: new URL(`/${getLocale()}`, Astro.site).href,
            image: personImage,
            jobTitle: "Software Engineer",
            description: m.aboutP1(),
            address: {
                "@type": "PostalAddress",
                addressLocality: "Rome",
                addressCountry: "IT",
            },
            sameAs: [
                "https://www.linkedin.com/in/everdev/",
                "https://github.com/ruizdiazever",
                "https://x.com/everruizdiazo",
            ],
            knowsAbout: [
                "Rust",
                "TypeScript",
                "platform engineering",
                "distributed systems",
                "design systems",
                "Postgres",
            ],
        },
        {
            "@type": "WebSite",
            "@id": websiteId,
            url: new URL(`/${getLocale()}`, Astro.site).href,
            name: seoConfig.siteName,
            inLanguage: language,
            publisher: { "@id": personId },
        },
        {
            "@type": isProfilePage ? "ProfilePage" : "WebPage",
            "@id": pageId,
            url: canonicalURL.href,
            name: title,
            description,
            isPartOf: { "@id": websiteId },
            about: { "@id": personId },
            inLanguage: language,
            dateModified: new Date().toISOString(),
        },
    ],
}).replaceAll("<", "\\u003c");
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
<meta name="color-scheme" content="light dark" />
<script is:inline>
    (() => {
        const meta = document.querySelector('meta[name="color-scheme"]');
        if (!meta) return;

        let stored = null;
        try {
            stored = localStorage.getItem("mode-watcher-mode");
        } catch {}

        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const scheme =
            stored === "light" || stored === "dark"
                ? stored
                : media.matches
                  ? "dark"
                  : "light";

        if (stored === "light" || stored === "dark") {
            meta.content = stored;
        }
        document.documentElement.classList.toggle("dark", scheme === "dark");

        media.addEventListener("change", () => {
            try {
                const current = localStorage.getItem("mode-watcher-mode");
                if (current === "light" || current === "dark") return;
            } catch {}
            document.documentElement.classList.toggle("dark", media.matches);
        });
    })();
</script>
<link rel="preconnect" href="https://s3.berli.app" crossorigin />
<title>{title}</title>
<meta name="description" content={description} />
<link type="text/plain" rel="author" href="/humans.txt" />

<!-- ImgLCP -->
{
    preloadImgLCP && (
        <link
            rel="preload"
            href={preloadImgLCP}
            as="image"
            type="image/webp"
            crossorigin
        />
    )
}
<!-- Manifest -->
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href={media("site/icons/favicon.svg")} />
<link rel="apple-touch-icon" href={media("site/icons/apple-touch-icon.png")} />
<link rel="icon" href={media("site/icons/favicon.ico")} sizes="32x32" />
<link rel="canonical" href={canonicalURL.href} />
<link rel="describedby" type="text/plain" href="/llms.txt" />
<link rel="alternate" type="text/markdown" href="/agent.md" title="Agent brief" />
<link rel="alternate" type="application/json" href="/agent.json" title="Agent manifest" />
<link
    rel="alternate"
    type="application/rss+xml"
    href={`/${getLocale()}/feed.xml`}
    title="RSS feed"
/>
<link
    rel="alternate"
    type="application/feed+json"
    href={`/${getLocale()}/feed.json`}
    title="JSON Feed"
/>
{
    LOCALES.map((lang) => (
        <link rel="alternate" hreflang={lang} href={localizedHref(lang)} />
    ))
}
<link rel="alternate" hreflang="x-default" href={localizedHref("en")} />

<!-- Meta -->
<meta name="msapplication-TileColor" content="#ffffff" />
<meta
    name="msapplication-TileImage"
    content={media("site/icons/ms-icon-144.png")}
/>
<meta name="theme-color" content="#08090a" />
<meta name="keywords" content="Ever Ruiz Diaz, Rust, TypeScript, software engineer, platform engineer, Rome" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@everruizdiazo" />
<meta name="twitter:creator" content="@everruizdiazo" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content={String(seoConfig.image.width)} />
<meta property="og:image:height" content={String(seoConfig.image.height)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={seoConfig.siteName} />
<meta property="og:locale" content={LOCALE[getLocale()]} />

<script type="application/ld+json" set:html={jsonLd} />

<!-- Robots -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Additional Meta Tags -->
<meta name="msapplication-config" content="/browserconfig.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
