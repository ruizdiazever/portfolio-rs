---
import * as m from "@paraglide/messages.js";
import Media from "$lib/components/common/Media.astro";
import Social from "$lib/components/common/Social.astro";
---

<footer>
    <div
        class="mx-auto max-w-(--breakpoint-md) py-8 mt-10 antialiased bg-transparent border-t px-4 sm:px-6 lg:px-8"
    >
        <div
            class="flex flex-col md:flex-row items-center justify-between space-y-2"
        >
            <div class="md:hidden">
                <Social />
            </div>
            <div
                class="flex justify-center items-center text-gray-600 dark:text-gray-400 sm:justify-start text-sm gap-2 hover:text-gray-800 dark:hover:text-gray-200 transition-colors"
            >
                <Media
                    path="site/mascot"
                    widths={[96, 192]}
                    width={32}
                    height={19}
                    sizes="32px"
                    alt="Rust mascot"
                    class="w-8 h-auto"
                />
                {m.rustLover()}
            </div>

            <p
                class="flex mt-4 text-center text-sm text-gray-500 dark:text-gray-400 lg:mt-0 lg:text-right"
            >
                Ever Ruiz Diaz<span class="mx-1">·</span>{
                    new Date().getFullYear()
                }
            </p>
        </div>

        <div
            class="mt-4 flex flex-col gap-1 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
        >
            <p>{m.colophon()}</p>
            <a
                href="https://github.com/ruizdiazever/portfolio-rs"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium hover:text-foreground"
            >
                {m.source()}
            </a>
        </div>
    </div>
</footer>
