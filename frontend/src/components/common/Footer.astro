---
import * as m from "@paraglide/messages.js";
import Media from "$lib/components/common/Media.astro";
import Social from "$lib/components/common/Social.astro";

interface Props {
    wide?: boolean;
}

const { wide = false } = Astro.props;
---

<footer>
    <div
        class={`mx-auto ${wide ? "max-w-(--breakpoint-lg)" : "max-w-(--breakpoint-md)"} py-8 mt-10 antialiased bg-transparent border-t px-4 sm:px-6 lg:px-8`}
    >
        <div
            class="flex flex-col md:flex-row items-center justify-between space-y-2"
        >
            <div class="md:hidden">
                <Social />
            </div>
            <div
                class="flex justify-center items-center text-muted-foreground sm:justify-start text-sm gap-2 hover:text-foreground transition-colors"
            >
                <Media
                    path="site/mascot"
                    widths={[96, 192]}
                    width={32}
                    height={19}
                    sizes="32px"
                    alt="Rust Evangelist Strike Force mascot"
                    class="w-8 h-auto"
                />
                {m.rustLover()}
            </div>

            <p
                class="flex mt-4 text-center text-sm text-muted-foreground lg:mt-0 lg:text-right"
            >
                Ever Ruiz Diaz<span class="mx-1">-</span>{
                    new Date().getFullYear()
                }
            </p>
        </div>
    </div>
</footer>
