---
import * as m from "@paraglide/messages.js";
import Media from "$lib/components/common/Media.astro";
import Social from "$lib/components/common/Social.astro";
import { getUrls } from "$lib/common/urls";

interface Props {
    wide?: boolean;
}

const { wide = false } = Astro.props;

const urls = getUrls();
const links = [
    { href: urls.about, label: m.about() },
    { href: urls.contact, label: m.contact() },
    { href: urls.privacy, label: m.privacy() },
];
---

<footer>
    <div
        class={`site-footer-inner mx-auto ${wide ? "max-w-(--breakpoint-lg)" : "max-w-(--breakpoint-md)"} py-8 mt-10 antialiased bg-transparent px-4 sm:px-6 lg:px-8`}
    >
        <div
            class="flex flex-col md:flex-row items-center justify-between space-y-2"
        >
            <div class="md:hidden">
                <Social />
            </div>
            <div
                class="group flex justify-center items-center text-muted-foreground sm:justify-start text-sm gap-2 hover:text-foreground transition-colors"
            >
                <Media
                    path="site/mascot"
                    widths={[96, 192]}
                    width={32}
                    height={19}
                    sizes="32px"
                    alt="Rust Evangelist Strike Force mascot"
                    class="w-8 h-auto grayscale transition-[filter] duration-150 ease-out group-hover:grayscale-0"
                />
                {m.rustLover()}
            </div>

            <p
                class="flex mt-4 text-center text-sm text-muted-foreground lg:mt-0 lg:text-right"
            >
                Ever Ruiz Diaz<span class="mx-1">-</span>{
                    new Date().getFullYear()
                }
            </p>
        </div>
        <nav
            aria-label={m.footerNav()}
            class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 border-t pt-4 text-sm text-muted-foreground md:justify-between"
        >
            <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
                {
                    links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="underline decoration-border underline-offset-4 transition-colors duration-150 ease-out hover:text-foreground hover:decoration-foreground"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
            <a
                href="/llms.txt"
                class="underline decoration-border underline-offset-4 transition-colors duration-150 ease-out hover:text-foreground hover:decoration-foreground"
            >
                llms.txt
            </a>
        </nav>
    </div>
</footer>
