---
import Social from "$lib/components/common/Social.astro";
import { Separator } from "$lib/components/ui/separator";
import WordAnimation from "$lib/components/landing/WordAnimation.astro";
import { getLocale } from "@paraglide/runtime";
import * as m from "@paraglide/messages.js";

interface Props {
    wide?: boolean;
}

const { wide = false } = Astro.props;

let showSeparator = false;

function handleSeparatorChange(event: CustomEvent<{ show: boolean }>) {
    showSeparator = event.detail.show;
}

const otherLocale = getLocale() === "en" ? "zh" : "en";
const languageHref = Astro.url.pathname
    .replace(/\/+$/, "")
    .replace(/^\/(en|zh)/, `/${otherLocale}`);
---

<nav
    id="navbar"
    class="sticky top-0 w-full bg-background/80 backdrop-blur-lg z-50 antialiased transition-colors duration-200"
    on:separator-change={handleSeparatorChange}
>
    <div class="w-full">
        <div
            class={`flex flex-wrap items-center justify-between gap-y-2 ${wide ? "max-w-(--breakpoint-lg)" : "max-w-(--breakpoint-md)"} mx-auto px-4 sm:px-6 lg:px-8 py-4 md:py-6`}
        >
            <a href={`/${getLocale()}/`} class="flex min-w-0 flex-col items-start">
                <p class="text-lg font-medium tracking-[-0.015em] text-foreground md:text-xl">
                    Ever Ruiz Diaz
                </p>
                <p class="text-secondary-foreground text-md h-[32px]">
                    <WordAnimation />
                </p>
            </a>
            <div class="flex shrink-0 items-center">
                <a
                    href={languageHref}
                    hreflang={otherLocale}
                    aria-label={m.language()}
                    title={m.language()}
                    class="inline-flex h-10 shrink-0 items-center justify-center whitespace-nowrap rounded-full px-3 text-sm font-medium transition-[color,background-color,transform] duration-150 ease-out hover:bg-accent hover:text-accent-foreground active:scale-95 md:h-9"
                >
                    {otherLocale === "zh" ? "中文" : "EN"}
                </a>
                <button
                    id="theme-toggle"
                    type="button"
                    aria-label={m.theme()}
                    title={m.theme()}
                    class="relative inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full transition-[color,background-color,transform] duration-150 ease-out hover:bg-accent hover:text-accent-foreground active:scale-95 md:h-9 md:w-9"
                >
                    <svg
                        class="h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-transform duration-150 ease-out dark:-rotate-90 dark:scale-0"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                    </svg>
                    <svg
                        class="absolute h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-transform duration-150 ease-out dark:rotate-0 dark:scale-100"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
                    </svg>
                </button>
                <div class="hidden md:flex items-center">
                    <Separator orientation="vertical" class="mx-2 h-6! w-0.5! bg-border!" />
                    <Social />
                </div>
            </div>
        </div>
    </div>
    {showSeparator && <Separator />}
</nav>

<script>
    function initializeNavbar() {
        const navbar = document.getElementById("navbar");
        if (navbar) {
            const handleScroll = () => {
                const show = window.scrollY > 0;
                navbar.querySelector("div")?.classList.toggle("border-b", show);

                navbar.dispatchEvent(
                    new CustomEvent("separator-change", {
                        detail: { show },
                    }),
                );
            };

            window.addEventListener("scroll", handleScroll);
            handleScroll(); // Initialize state on page load
        }
    }

    initializeNavbar();

    function initializeThemeToggle() {
        const button = document.getElementById("theme-toggle");
        if (!button) return;
        button.addEventListener("click", () => {
            const dark = document.documentElement.classList.toggle("dark");
            localStorage.setItem("mode-watcher-mode", dark ? "dark" : "light");
        });
    }

    initializeThemeToggle();
</script>
