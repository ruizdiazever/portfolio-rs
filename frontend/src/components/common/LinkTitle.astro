---
import { Icon } from "astro-icon/components";

interface Props {
    url: string;
    title: string;
}

let { title, url = "_self" }: Props = Astro.props;
---

<a
    href={url}
    rel="noopener"
    target="_self"
    class="flex group items-center gap-1 text-lg font-medium tracking-[-0.012em] md:text-xl
    text-foreground duration-150 cursor-pointer
    hover:underline hover:decoration-dashed hover:underline-offset-8 hover:decoration-foreground/40"
>
    {title}
    <Icon
        name="arrow-right"
        title="Link"
        class="duration-150 ease-out group-hover:translate-x-[1.5px] w-4 h-4"
    />
</a>
