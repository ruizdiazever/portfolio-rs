---
import { Icon } from "astro-icon/components";

interface Props {
    url: string;
    title: string;
}

let { title, url }: Props = Astro.props;
---

<a
    href={url}
    rel="noopener"
    target="_blank"
    class="group inline-flex items-center text-foreground underline decoration-foreground/30 underline-offset-4 duration-150
    hover:decoration-foreground"
>
    {title}
    <Icon
        name="arrow-up-right"
        aria-hidden="true"
        class="duration-200 group-hover:translate-x-[1.5px] w-4 h-4 shrink-0"
    />
</a>
