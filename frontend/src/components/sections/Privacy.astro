---
import PageHeader from "$lib/components/common/PageHeader.astro";
import * as m from "@paraglide/messages.js";
---

<div class="min-h-[60vh] pb-16">
    <PageHeader title={m.privacy()} description={m.privacyIntro()} />

    <div class="mt-10 max-w-[68ch] space-y-8">
        <section class="space-y-2">
            <h2 class="text-xl font-medium tracking-[-0.017em]">
                {m.privacyAnalyticsTitle()}
            </h2>
            <p class="text-md text-pretty text-muted-foreground">
                {m.privacyAnalyticsBody()}
            </p>
        </section>
        <section class="space-y-2">
            <h2 class="text-xl font-medium tracking-[-0.017em]">
                {m.privacyFeedbackTitle()}
            </h2>
            <p class="text-md text-pretty text-muted-foreground">
                {m.privacyFeedbackBody()}
            </p>
        </section>
        <section class="space-y-2">
            <h2 class="text-xl font-medium tracking-[-0.017em]">
                {m.privacyViewsTitle()}
            </h2>
            <p class="text-md text-pretty text-muted-foreground">
                {m.privacyViewsBody()}
            </p>
        </section>
        <section class="space-y-2">
            <h2 class="text-xl font-medium tracking-[-0.017em]">
                {m.privacyControllerTitle()}
            </h2>
            <p class="text-md text-pretty text-muted-foreground">
                {m.privacyControllerBody()}
            </p>
        </section>
    </div>
</div>
