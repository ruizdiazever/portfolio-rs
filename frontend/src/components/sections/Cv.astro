---
import Layout from "$lib/layouts/Layout.astro";
import PageHeader from "$lib/components/common/PageHeader.astro";
import * as m from "@paraglide/messages.js";
import { Icon } from "astro-icon/components";
---

<Layout title={m.titleCv()} description={m.seoCv()}>
    <div class="min-h-[60vh] pb-16">
        <PageHeader title={m.cv()} description={m.cvIntro()}>
            <a
                href="https://www.linkedin.com/in/everdev/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-md font-medium text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground"
            >
                LinkedIn
                <Icon name="arrow-right" aria-hidden="true" class="h-4 w-4" />
            </a>
        </PageHeader>
    </div>
</Layout>
