---
import Layout from "$lib/layouts/Layout.astro";
import * as m from "@paraglide/messages.js";
import { Icon } from "astro-icon/components";
import { getLocale } from "@paraglide/runtime";
---

<Layout title={m.titleCv()} description={m.seoCv()}>
    <div class="mt-10 max-w-[60ch] space-y-4">
        <h1 class="text-4xl font-medium tracking-[-0.022em] sm:text-5xl">
            {m.cv()}
        </h1>
        <p class="text-lg text-secondary-foreground">{m.cvIntro()}</p>
        <a
            href="https://www.linkedin.com/in/everdev/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-medium text-foreground underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground"
        >
            LinkedIn
            <Icon
                name="arrow-right"
                aria-hidden="true"
                class="h-4 w-4"
            />
        </a>
        <p class="pt-6 text-sm">
            <a href={`/${getLocale()}`} class="text-muted-foreground hover:text-foreground">
                ← {m.goHome()}
            </a>
        </p>
    </div>
</Layout>
