---
import Media from "$lib/components/common/Media.astro";
import * as m from "@paraglide/messages.js";
import { getLocale } from "@paraglide/runtime";

const links = [
    { label: "Anritsu", href: "https://www.anritsu.com/en-gb/" },
    { label: "BERLi", href: "https://github.com/berli-app" },
    { label: "GitHub", href: "https://github.com/ruizdiazever" },
    { label: "X", href: "https://x.com/everruizdiazo" },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/everdev/" },
];
---

<div class="min-h-screen">
    <div class="mx-auto py-16">
        <div class="text-left space-y-6">
            <h1
                class="text-4xl font-semibold tracking-[-0.035em] text-gray-900 dark:text-white sm:text-5xl md:text-6xl"
            >
                {m.about()}
            </h1>

            <div class="mt-3 max-w-[68ch] text-md text-foreground space-y-6">
                <p>{m.aboutP1()}</p>
                <p>{m.aboutP2()}</p>
                <p>{m.aboutP3()}</p>
            </div>

            <Media
                path="site/about"
                widths={[800, 1600]}
                width={800}
                height={600}
                sizes="(min-width: 768px) 800px, 100vw"
                alt="Ever Ruiz Diaz"
                class="rounded-xl mt-6 w-full"
            />

            <dl
                class="grid grid-cols-1 gap-x-8 gap-y-4 border-t pt-6 text-sm sm:grid-cols-2"
            >
                <div>
                    <dt class="text-muted-foreground">{m.aboutBasedIn()}</dt>
                    <dd class="mt-1 text-foreground">
                        {m.aboutBasedInValue()}
                    </dd>
                </div>
                <div>
                    <dt class="text-muted-foreground">{m.aboutWorkingWith()}</dt>
                    <dd class="mt-1 text-foreground">
                        {m.aboutWorkingWithValue()}
                    </dd>
                </div>
                <div>
                    <dt class="text-muted-foreground">{m.aboutLanguages()}</dt>
                    <dd class="mt-1 text-foreground">
                        {m.aboutLanguagesValue()}
                    </dd>
                </div>
                <div>
                    <dt class="text-muted-foreground">{m.aboutCurrently()}</dt>
                    <dd class="mt-1 text-foreground">
                        <a
                            href={`/${getLocale()}/projects/berli-system`}
                            class="font-medium underline decoration-1 underline-offset-4 hover:text-[#68b5fc]"
                        >
                            {m.aboutCurrentlyValue()}
                        </a>
                    </dd>
                </div>
            </dl>

            <p class="text-sm font-medium text-muted-foreground">
                {m.aboutLinks()}
            </p>
            <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1 underline decoration-1 underline-offset-4 hover:text-[#68b5fc]"
                        >
                            {link.label}
                            <span aria-hidden="true">↗</span>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</div>
