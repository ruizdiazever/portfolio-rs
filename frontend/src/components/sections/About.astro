---
import { Picture } from "astro:assets";
import { aboutMain } from "$lib/common/minio/about";
---

<div class="min-h-screen">
    <div class="mx-auto py-16">
        <div class="text-left space-y-6">
            <h1
                class="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-5xl md:text-6xl transition-all"
            >
                <span class="block">About</span>
            </h1>

            <div
                class="mt-3 text-lg text-foreground transition-colors space-y-6"
            >
                <p>
                    I stand at the intersection of rigorous engineering and
                    intuitive design. For me, software isn't just about code—it's
                    about crafting experiences that feel inevitable.
                </p>
                <p>
                    I believe that true innovation is quiet. It doesn't shout;
                    it works. My focus is on building reliable, safe, and
                    performant systems that respect the user's time and
                    intelligence.
                </p>
                <p>
                    In a world of noise, I strive to create clarity. Through
                    Rust and thoughtful architecture, I aim to bridge the gap
                    between complex logic and human interactions, redefining
                    what we expect from the tools we use every day.
                </p>
            </div>
            <Picture
                class="rounded-xl mt-6"
                src={aboutMain.me}
                alt="A description of my image."
                formats={["avif", "webp"]}
                alt="BERLi Dashboard"
                width={1141}
                height={641}
            />
        </div>
    </div>
</div>
