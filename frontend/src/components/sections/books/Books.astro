---
import { books } from "./data";
import { type Book } from "./data";
import Media from "$lib/components/common/Media.astro";
import * as m from "@paraglide/messages.js";
import { getLocale } from "@paraglide/runtime";

const genreZh: Record<string, string> = {
    "Science Fiction": "科幻",
    "Literary Fiction": "文学",
    "Political Satire": "政治讽喻",
    "Technical Paper": "技术论文",
    Fantasy: "奇幻",
    Biography: "传记",
    Technical: "技术",
    Comics: "漫画",
};
---

<div class="mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6 max-w-(--breakpoint-lg)">
    <h1
        class="text-4xl text-center font-medium tracking-[-0.022em] sm:text-5xl md:text-6xl"
    >
        <span class="block">{m.reading()}</span>
    </h1>
    <p class="mx-auto max-w-[52ch] text-center text-md text-secondary-foreground">
        {m.readingIntro()}
    </p>

    <div class="flex flex-wrap justify-center gap-2 mb-8">
        <button
            class="px-4 py-2 rounded-full border border-border font-medium text-sm transition-[color,background-color,border-color,transform] duration-150 ease-out hover:border-foreground/40 active:scale-[0.98] aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            data-filter="all"
            aria-pressed="false">{m.all()}</button
        >
        <button
            class="px-4 py-2 rounded-full border border-border font-medium text-sm transition-[color,background-color,border-color,transform] duration-150 ease-out hover:border-foreground/40 active:scale-[0.98] aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            data-filter="technical"
            aria-pressed="true">{m.technical()}</button
        >
        <button
            class="px-4 py-2 rounded-full border border-border font-medium text-sm transition-[color,background-color,border-color,transform] duration-150 ease-out hover:border-foreground/40 active:scale-[0.98] aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            data-filter="paper"
            aria-pressed="false">{m.papers()}</button
        >
        <button
            class="px-4 py-2 rounded-full border border-border font-medium text-sm transition-[color,background-color,border-color,transform] duration-150 ease-out hover:border-foreground/40 active:scale-[0.98] aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            data-filter="comic"
            aria-pressed="false">{m.comics()}</button
        >
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 lg gap-6">
        {
            books.map((book: Book) => (
                <div
                    class:list={[
                        "book-card group rounded-lg bg-card overflow-hidden border relative min-h-[400px] transition-[border-color,background-color] duration-150 ease-out hover:border-foreground/30 focus-visible:border-foreground/30 hover:z-10 focus-visible:z-10 w-full",
                        { hidden: !book.technical },
                    ]}
                    transition:name={`book-card-${book.title}`}
                    role="group"
                    aria-label={`${book.title} details`}
                    tabindex="0"
                    data-technical={book.technical}
                    data-paper={book.paper}
                    data-comic={book.comic}
                >
                    <div class="content group-hover:opacity-0 group-focus:opacity-0 transition-opacity duration-200 ease-out h-full flex flex-col">
                        <div class="relative aspect-3/4 overflow-hidden w-full">
                            <Media
                                path={book.cover}
                                widths={[480]}
                                width={300}
                                height={400}
                                sizes="(min-width: 768px) 25vw, 90vw"
                                alt={book.title}
                                class="w-full h-full object-contain p-4"
                            />
                            <div class="absolute inset-0 bg-linear-to-t from-gray-600/20 to-transparent" />
                        </div>

                        <div class="p-4 flex-1 flex flex-col">
                            <h2 class="text-md font-medium leading-[1.35] tracking-[-0.01em] text-foreground mb-2 line-clamp-2">
                                {book.title}
                            </h2>
                            <p class="text-sm mb-4 text-muted-foreground line-clamp-1">
                                {m.by()}{getLocale() === "zh" ? "" : " "}{book.author}
                            </p>
                            <div class="mt-auto flex gap-2 flex-wrap">
                                <span class="px-2 py-1 text-xs bg-secondary rounded">
                                    {book.publishedYear}
                                </span>
                                <span class="px-2 py-1 text-xs bg-secondary rounded">
                                    {book.technical
                                        ? m.technical()
                                        : m.nonTechnical()}
                                </span>
                            </div>
                        </div>
                    </div>

                    <div
                        class="details opacity-0 group-hover:opacity-100 group-focus:opacity-100 absolute inset-0 transition-opacity duration-200 ease-out
                        overflow-y-auto overscroll-contain pointer-events-none group-hover:pointer-events-auto group-focus:pointer-events-auto flex flex-col"
                    >
                        <div class="p-6 flex-1">
                            <h2 class="text-md font-medium leading-[1.35] tracking-[-0.01em] text-foreground mb-3">{book.title}</h2>
                            <p class="text-sm mb-4">
                                {m.by()}{getLocale() === "zh" ? "" : " "}{book.author}
                            </p>
                            <p class="text-sm mb-6">
                                {getLocale() === "zh"
                                    ? book.descriptionZh
                                    : book.description}
                            </p>
                        </div>

                        <div class="mt-auto p-4 border-t">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm font-medium">{m.published()}</p>
                                    <p class="text-sm">{book.publishedYear}</p>
                                </div>
                                <div>
                                    <p class="text-sm font-medium">{m.type()}</p>
                                    <p class="text-sm">
                                        {book.technical
                                            ? m.technical()
                                            : m.nonTechnical()}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm font-medium">{m.format()}</p>
                                    <p class="text-sm">
                                        {book.paper ? m.paper() : m.digital()}
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm font-medium">{m.genre()}</p>
                                    <p class="text-sm">{getLocale() === "zh" ? (genreZh[book.genre] ?? book.genre) : book.genre}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>

    <script>
        type FilterType = "all" | "technical" | "paper" | "comic";

        const FILTERS: FilterType[] = ["all", "technical", "paper", "comic"];
        const DEFAULT_FILTER: FilterType = "technical";

        const buttons =
            document.querySelectorAll<HTMLButtonElement>("[data-filter]");
        const books = document.querySelectorAll<HTMLElement>(".book-card");

        const filterFromUrl = (): FilterType => {
            const value = new URLSearchParams(location.search).get("filter");
            return value && FILTERS.includes(value as FilterType)
                ? (value as FilterType)
                : DEFAULT_FILTER;
        };

        const applyFilter = (filter: FilterType, updateUrl = false) => {
            buttons.forEach((button) => {
                const active = button.dataset.filter === filter;
                button.setAttribute("aria-pressed", String(active));
            });

            books.forEach((book) => {
                const visible =
                    filter === "all" ||
                    book.getAttribute(`data-${filter}`) === "true";
                book.classList.toggle("hidden", !visible);
            });

            if (!updateUrl) return;

            const url = new URL(location.href);
            if (url.searchParams.get("filter") === filter) return;
            url.searchParams.set("filter", filter);
            history.pushState({ filter }, "", url);
        };

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                applyFilter(button.dataset.filter as FilterType, true);
            });
        });

        window.addEventListener("popstate", () => {
            applyFilter(filterFromUrl());
        });

        applyFilter(filterFromUrl());
    </script>
</div>
