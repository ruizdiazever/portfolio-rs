---
import { books } from "./data";
import Media from "$lib/components/common/Media.astro";
import * as m from "@paraglide/messages.js";
import { getLocale } from "@paraglide/runtime";

const genreZh: Record<string, string> = {
    "Science Fiction": "科幻",
    "Literary Fiction": "文学",
    "Political Satire": "政治讽喻",
    "Technical Paper": "技术论文",
    Fantasy: "奇幻",
    Biography: "传记",
    Technical: "技术",
    Comics: "漫画",
};

const locale = getLocale();
const cards = books.map((book) => ({
    ...book,
    description: locale === "zh" ? book.descriptionZh : book.description,
    genre: locale === "zh" ? (genreZh[book.genre] ?? book.genre) : book.genre,
    type: book.technical ? m.technical() : m.nonTechnical(),
    format: book.paper ? m.paper() : m.digital(),
}));
---

<div class="mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6 max-w-(--breakpoint-lg)">
    <h1
        class="text-4xl text-center font-medium tracking-[-0.022em] sm:text-5xl md:text-6xl"
    >
        <span class="block">{m.reading()}</span>
    </h1>
    <p class="mx-auto max-w-[52ch] text-center text-md text-secondary-foreground">
        {m.readingIntro()}
    </p>

    <div class="flex flex-wrap justify-center gap-2 mb-8">
        <button
            type="button"
            class="px-4 py-2 rounded-full border border-border font-medium text-sm transition-[color,background-color,border-color,transform] duration-150 ease-out hover:border-foreground/40 active:scale-[0.98] aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            data-filter="all"
            aria-pressed="false">{m.all()}</button
        >
        <button
            type="button"
            class="px-4 py-2 rounded-full border border-border font-medium text-sm transition-[color,background-color,border-color,transform] duration-150 ease-out hover:border-foreground/40 active:scale-[0.98] aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            data-filter="technical"
            aria-pressed="true">{m.technical()}</button
        >
        <button
            type="button"
            class="px-4 py-2 rounded-full border border-border font-medium text-sm transition-[color,background-color,border-color,transform] duration-150 ease-out hover:border-foreground/40 active:scale-[0.98] aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            data-filter="paper"
            aria-pressed="false">{m.papers()}</button
        >
        <button
            type="button"
            class="px-4 py-2 rounded-full border border-border font-medium text-sm transition-[color,background-color,border-color,transform] duration-150 ease-out hover:border-foreground/40 active:scale-[0.98] aria-pressed:bg-primary aria-pressed:text-primary-foreground"
            data-filter="comic"
            aria-pressed="false">{m.comics()}</button
        >
    </div>
    <p
        id="book-filter-status"
        class="sr-only"
        role="status"
        aria-live="polite"
    ></p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
            cards.map((book) => (
                <div
                    class:list={[
                        "book-card group relative w-full",
                        { hidden: !book.technical },
                    ]}
                    transition:name={`book-card-${book.title}`}
                    data-technical={book.technical}
                    data-paper={book.paper}
                    data-comic={book.comic}
                >
                    <div class="book-flip">
                        <div class="book-face book-front flex flex-col rounded-lg border border-border bg-card transition-[border-color,background-color] duration-150 ease-out group-hover:border-foreground/30 group-hover:bg-muted/20 group-focus-within:border-foreground/30">
                            <div class="relative aspect-3/4 w-full overflow-hidden rounded-t-[11px]">
                                <Media
                                    path={book.cover}
                                    widths={[480]}
                                    width={300}
                                    height={400}
                                    sizes="(min-width: 768px) 25vw, 90vw"
                                    alt={book.title}
                                    class="w-full h-full object-contain p-4 transition-transform duration-300 ease-out group-hover:scale-[1.02]"
                                />
                                <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/20 to-transparent" />
                                <span
                                    class="absolute right-3 top-3 rounded-full border border-white/15 bg-black/50 px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.08em] text-white/80 backdrop-blur"
                                    aria-hidden="true"
                                >
                                    {m.flip()}
                                </span>
                            </div>

                            <div class="flex flex-1 flex-col p-4">
                                <h2 class="mb-2 line-clamp-2 text-md font-medium leading-[1.35] tracking-[-0.01em] text-foreground">
                                    {book.title}
                                </h2>
                                <p class="mb-4 line-clamp-1 text-sm text-muted-foreground">
                                    {m.by()}{locale === "zh" ? "" : " "}{book.author}
                                </p>
                                <div class="mt-auto flex flex-wrap gap-2">
                                    <span class="rounded bg-secondary px-2 py-1 text-xs">
                                        {book.publishedYear}
                                    </span>
                                    <span class="rounded bg-secondary px-2 py-1 text-xs">
                                        {book.type}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div
                            class="book-face book-back rounded-lg border border-border bg-card transition-colors duration-150 ease-out group-hover:border-foreground/30"
                            aria-hidden="true"
                            inert
                        >
                            <div class="flex h-full flex-col p-4">
                                <div class="flex items-center justify-between gap-3 text-[10px] font-medium uppercase tracking-[0.1em] text-muted-foreground">
                                    <span>{m.bookNotes()}</span>
                                    <span>{book.publishedYear}</span>
                                </div>
                                <div class="my-auto py-4">
                                    <h2 class="text-md font-medium leading-[1.3] tracking-[-0.01em] text-foreground">
                                        {book.title}
                                    </h2>
                                    <p class="mt-1 text-xs text-muted-foreground">
                                        {m.by()}{locale === "zh" ? "" : " "}{book.author}
                                    </p>
                                    <p class="mt-3 text-xs leading-relaxed text-secondary-foreground">
                                        {book.description}
                                    </p>
                                    <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-border pt-3">
                                    <div>
                                        <dt class="text-[10px] font-medium uppercase tracking-[0.08em] text-muted-foreground">
                                            {m.published()}
                                        </dt>
                                        <dd class="mt-0.5 text-xs text-foreground">
                                            {book.publishedYear}
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="text-[10px] font-medium uppercase tracking-[0.08em] text-muted-foreground">
                                            {m.type()}
                                        </dt>
                                        <dd class="mt-0.5 text-xs text-foreground">
                                            {book.type}
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="text-[10px] font-medium uppercase tracking-[0.08em] text-muted-foreground">
                                            {m.format()}
                                        </dt>
                                        <dd class="mt-0.5 text-xs text-foreground">
                                            {book.format}
                                        </dd>
                                    </div>
                                    <div>
                                        <dt class="text-[10px] font-medium uppercase tracking-[0.08em] text-muted-foreground">
                                            {m.genre()}
                                        </dt>
                                        <dd class="mt-0.5 text-xs text-foreground">
                                            {book.genre}
                                        </dd>
                                    </div>
                                    </dl>
                                </div>
                                <button
                                    type="button"
                                    class="book-card-back-toggle mx-auto mt-3 rounded-full border border-border px-3 py-1 text-[11px] font-medium text-muted-foreground transition-[color,border-color,transform] duration-150 ease-out hover:border-foreground/30 hover:text-foreground active:scale-[0.97]"
                                >
                                    {m.tapToCover()}
                                </button>
                            </div>
                        </div>
                    </div>

                    <button
                        type="button"
                        class="book-card-toggle absolute inset-0 z-20 cursor-pointer rounded-lg active:bg-foreground/5"
                        aria-label={`${book.title}, ${m.flip()}`}
                        data-flip-label={`${book.title}, ${m.flip()}`}
                        data-back-label={`${book.title}, ${m.tapToCover()}`}
                        aria-pressed="false"
                    ></button>
                </div>
            ))
        }
    </div>

    <script>
        type FilterType = "all" | "technical" | "paper" | "comic";

        const FILTERS: FilterType[] = ["all", "technical", "paper", "comic"];
        const DEFAULT_FILTER: FilterType = "technical";

        const buttons =
            document.querySelectorAll<HTMLButtonElement>("[data-filter]");
        const books = document.querySelectorAll<HTMLElement>(".book-card");

        const filterFromUrl = (): FilterType => {
            const value = new URLSearchParams(location.search).get("filter");
            return value && FILTERS.includes(value as FilterType)
                ? (value as FilterType)
                : DEFAULT_FILTER;
        };

        const applyFilter = (filter: FilterType, updateUrl = false) => {
            buttons.forEach((button) => {
                const active = button.dataset.filter === filter;
                button.setAttribute("aria-pressed", String(active));
            });

            books.forEach((book) => {
                const visible =
                    filter === "all" ||
                    book.getAttribute(`data-${filter}`) === "true";
                book.classList.toggle("hidden", !visible);
            });

            const status = document.getElementById("book-filter-status");
            if (status) {
                const visible = Array.from(books).filter(
                    (book) => !book.classList.contains("hidden"),
                ).length;
                status.textContent =
                    document.documentElement.lang === "zh"
                        ? `显示 ${visible} 本书`
                        : `Showing ${visible} ${visible === 1 ? "book" : "books"}`;
            }

            if (!updateUrl) return;

            const url = new URL(location.href);
            if (url.searchParams.get("filter") === filter) return;
            url.searchParams.set("filter", filter);
            history.pushState({ filter }, "", url);
        };

        buttons.forEach((button) => {
            button.addEventListener("click", () => {
                applyFilter(button.dataset.filter as FilterType, true);
            });
        });

        window.addEventListener("popstate", () => {
            applyFilter(filterFromUrl());
        });

        applyFilter(filterFromUrl());

        document
            .querySelectorAll<HTMLButtonElement>(".book-card-toggle")
            .forEach((toggle) => {
                const card = toggle.closest<HTMLElement>(".book-card");
                const front = card?.querySelector<HTMLElement>(".book-front");
                const back = card?.querySelector<HTMLElement>(".book-back");
                if (!card || !front || !back) return;

                const flipLabel = toggle.dataset.flipLabel ?? "";
                const backLabel = toggle.dataset.backLabel ?? "";

                const backToggle = card.querySelector<HTMLButtonElement>(
                    ".book-card-back-toggle",
                );

                const setFlipped = (flipped: boolean) => {
                    card.classList.toggle("is-flipped", flipped);
                    toggle.setAttribute("aria-pressed", String(flipped));
                    toggle.setAttribute(
                        "aria-label",
                        flipped ? backLabel : flipLabel,
                    );
                    toggle.style.pointerEvents = flipped ? "none" : "";
                    front.setAttribute("aria-hidden", String(flipped));
                    back.setAttribute("aria-hidden", String(!flipped));
                    front.toggleAttribute("inert", flipped);
                    back.toggleAttribute("inert", !flipped);
                };

                setFlipped(false);
                toggle.addEventListener("click", () => {
                    setFlipped(!card.classList.contains("is-flipped"));
                });
                backToggle?.addEventListener("click", () => {
                    setFlipped(false);
                    toggle.focus();
                });
            });
    </script>
</div>

    <style>
        .book-card {
            height: 100%;
            perspective: 1200px;
        }

        .book-flip {
            position: relative;
            height: 100%;
            transform-style: preserve-3d;
            transition: transform 620ms cubic-bezier(0.34, 1.2, 0.64, 1);
        }

        .book-card.is-flipped .book-flip {
            transform: rotateY(180deg);
        }

        .book-face {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }

        .book-front {
            height: 100%;
            overflow: hidden;
        }

        .book-back {
            position: absolute;
            inset: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
            transform: rotateY(180deg);
        }

        @media (prefers-reduced-motion: reduce) {
            .book-flip {
                transition: none;
            }
        }
    </style>
