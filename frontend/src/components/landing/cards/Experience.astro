---
import dayjs from "dayjs";
import { getLocale } from "@paraglide/runtime";
import LinkExternal from "$lib/components/common/LinkExternal.astro";

interface Props {
    startDate: Date;
    endDate: Date | null;
    current: boolean;
    position: string;
    company: string;
    url: string;
    description: string;
}

let {
    position,
    description,
    startDate,
    endDate,
    current,
    url,
    company,
}: Props = Astro.props;
---

<div class="relative z-10 grid gap-1">
    <div
        class={`absolute left-0 top-[5px] z-20 aspect-square w-3 -translate-x-[29.5px] rounded-full ring-[3px] ring-background ${current ? "bg-foreground/70" : "bg-foreground/20"}`}
        data-timeline-dot
    >
    </div>
    <div class="text-sm text-muted-foreground tabular-nums" data-timeline-date>
        {
            getLocale() === "zh"
                ? `${dayjs(startDate).format("YYYY年MM月")} - ${endDate ? dayjs(endDate).format("YYYY年MM月") : "至今"}`
                : `${dayjs(startDate).locale("en").format("MMM YYYY")} - ${endDate ? dayjs(endDate).locale("en").format("MMM YYYY") : "Present"}`
        }
    </div>
    <div class="text-xl font-medium tracking-[-0.015em] text-foreground">{position}</div>
    <div class="mb-1 text-md text-muted-foreground">
        <LinkExternal title={company} url={url} />
    </div>
    <div class="text-secondary-foreground text-md">
        {description}
    </div>
</div>
