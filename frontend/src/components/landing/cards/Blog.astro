---
import { Icon } from "astro-icon/components";
import * as m from "@paraglide/messages.js";
import LinkTitle from "$lib/components/common/LinkTitle.astro";
import { formatMonth } from "$lib/common/formatDate";

interface Props {
    title: string;
    pinned: boolean;
    url: string;
    description: string;
    views: number;
    tags: string[];
    date: Date;
    headingLevel?: 2 | 3 | 4;
}

let {
    title,
    url,
    description,
    views,
    tags,
    date,
    pinned,
    headingLevel = 3,
}: Props = Astro.props;
---

<article class="relative flex flex-wrap flex-row items-center h-auto">
    <div class="flex-1 flex flex-col gap-2 w-full">
        <div class="flex justify-between items-center w-full">
            <div class="flex flex-col items-left gap-2">
                {
                    pinned && (
                        <div class="flex items-center gap-2 text-sm text-muted-foreground">
                            <Icon
                                name="pinned"
                                aria-hidden="true"
                                class="w-4 h-4 shrink-0 text-muted-foreground"
                            />
                            <p>{m.pinned()}</p>
                        </div>
                    )
                }
                <LinkTitle title={title} url={url} {headingLevel} />
            </div>
        </div>
        <p class="text-md text-secondary-foreground break-words">
            {description}
        </p>
        <div
            class="flex flex-wrap justify-left items-center mt-2 text-sm text-muted-foreground gap-4"
        >
            <div class="inline-flex items-center justify-center gap-1 font-medium">
                <Icon name="eye" aria-hidden="true" class="w-4 h-4 shrink-0" />
                <span class="whitespace-nowrap tabular-nums"
                    >{views ?? 0} {views === 1 ? m.viewSingular() : m.views()}</span
                >
            </div>
            <div class="inline-flex items-center justify-center gap-1 font-medium">
                <Icon name="tag" aria-hidden="true" class="w-4 h-4 shrink-0" />
                <span class="whitespace-nowrap tabular-nums"
                    >{tags?.length ? tags.length : 0} {m.tags()}</span
                >
            </div>
            <div class="inline-flex items-center justify-center gap-1 font-medium">
                <Icon name="date" aria-hidden="true" class="w-4 h-4 shrink-0" />
                <span class="whitespace-nowrap tabular-nums">
                    {formatMonth(date)}
                </span>
            </div>
        </div>
    </div>
</article>
