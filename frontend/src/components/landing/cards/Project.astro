---
import { Icon } from "astro-icon/components";
import LinkTitle from "$lib/components/common/LinkTitle.astro";
import { getTechnologiesFromJson } from "$lib/common/getTechData.js";
import { getLocale } from "@paraglide/runtime";

interface Props {
    url: string;
    title: string;
    repository: string;
    description: string;
    tech: string[];
}

const technologies = await getTechnologiesFromJson();
let { url, title, repository, description, tech }: Props = Astro.props;
---

<article class="group relative block w-full">
    <div
        class="relative p-2 flex
        border rounded-lg bg-card hover:border-foreground/30 hover:bg-muted/30
        transition-[border-color,background-color] duration-150 ease-out"
    >
        <div class="flex flex-col px-2 my-2 gap-2 pr-10 pt-0!">
            <LinkTitle title={title} url={url} />
            {
                repository !== "" && (
                    <span>
                        <a
                            href={repository}
                            rel="noopener"
                            target="_blank"
                            aria-label={getLocale() === "zh" ? `${title} 的 GitHub 仓库` : `${title} on GitHub`}
                            class="absolute top-3 right-3 inline-flex size-7 items-center justify-center rounded-md text-muted-foreground hover:text-foreground"
                        >
                            <Icon
                                name="github"
                                aria-hidden="true"
                                width="1.2em"
                                height="1.2em"
                            />
                        </a>
                    </span>
                )
            }
            <p class="text-md text-card-foreground pb-1 line-clamp-3">
                {description}
            </p>
            <div class="flex gap-4">
                {
                    tech.map((n) => {
                        if (!technologies[n]) return null;

                        return (
                            <a
                                href={technologies[n].url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={technologies[n].name}
                                title={technologies[n].description[getLocale()]}
                                data-tech
                                class="inline-flex size-7 items-center justify-center text-muted-foreground hover:text-foreground transition-colors duration-200"
                            >
                                <Icon
                                    name={n}
                                    aria-hidden="true"
                                    width="1.3em"
                                    height="1.3em"
                                />
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </div>
</article>
