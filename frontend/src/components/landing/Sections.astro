---
import { Icon } from "astro-icon/components";
import { getUrls } from "$lib/common/urls";
import * as m from "@paraglide/messages.js";

const urls = getUrls();
---

<div class="grid grid-cols-2 gap-4 mt-2" data-sections>
    {
        [
            { href: urls.about, text: m.about() },
            { href: urls.cv, text: m.cv() },
            { href: urls.contact, text: m.contact() },
            { href: urls.books, text: m.reading() },
        ].map((link) => (
            <a
                class="group flex items-center justify-between px-4 py-3 text-md font-medium text-foreground bg-card border rounded-lg hover:border-foreground/30 hover:bg-muted/40 transition-[border-color,background-color,transform] duration-150 ease-out active:scale-[0.99]"
                href={link.href}
            >
                {link.text}
                <Icon
                    name="arrow-right"
                    aria-hidden="true"
                    class="duration-150 ease-out group-hover:translate-x-[1.5px] w-4 h-4"
                />
            </a>
        ))
    }
</div>
