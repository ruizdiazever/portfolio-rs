---
import GithubContributions from "./GithubContributions.svelte";
import { GITHUB_TOKEN } from "astro:env/server";
import { getGithubContributions } from "$lib/common/githubContributions";
import { Icon } from "astro-icon/components";

const { weeks, totalContributions } =
    await getGithubContributions(GITHUB_TOKEN);
---

<GithubContributions {weeks} {totalContributions}>
    <Icon name="github" size={18} slot="gitHubIcon" aria-hidden="true" />
</GithubContributions>
