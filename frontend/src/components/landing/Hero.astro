---
import * as m from "@paraglide/messages.js";
import Media from "$lib/components/common/Media.astro";
---

<div class="flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-5 mt-6">
    <div
        class="relative flex size-20 sm:size-24 shrink-0 overflow-hidden rounded-full border"
    >
        <Media
            path="site/avatar"
            widths={[96, 192]}
            width={96}
            height={96}
            sizes="(min-width: 640px) 96px, 80px"
            alt="Ever Ruiz Diaz"
            class="aspect-square size-full dark:bg-black"
            loading="eager"
            fetchpriority="high"
        />
    </div>
    <div class="min-w-0">
        <h1
            class="text-xl md:text-2xl font-semibold text-foreground text-balance"
        >
            {m.meTitle()}
        </h1>
        <p class="mt-2 text-md md:text-lg text-secondary-foreground text-pretty">
            {m.meDescription()}
        </p>
    </div>
</div>
