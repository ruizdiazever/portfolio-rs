---
import * as m from "@paraglide/messages.js";

const tools = [
    {
        name: "DeepSeek Harness",
        href: "https://github.com/deepseek-ai/deepseek-harness",
        icon: "https://cdn.jsdelivr.net/npm/simple-icons@16.37.0/icons/deepseek.svg",
        role: m.dailyToolAgentHarness(),
    },
    {
        name: "Firefox",
        href: "https://www.mozilla.org/firefox/",
        icon: "https://cdn.jsdelivr.net/npm/simple-icons@16.37.0/icons/firefox.svg",
        role: m.dailyToolBrowser(),
    },
    {
        name: "Bitwarden",
        href: "https://bitwarden.com",
        icon: "https://cdn.jsdelivr.net/npm/simple-icons@16.37.0/icons/bitwarden.svg",
        role: m.dailyToolPasswords(),
    },
    {
        name: "Docker Desktop",
        href: "https://www.docker.com/products/docker-desktop/",
        icon: "https://cdn.jsdelivr.net/npm/simple-icons@16.37.0/icons/docker.svg",
        role: m.dailyToolContainers(),
    },
    {
        name: "Warp",
        href: "https://www.warp.dev",
        icon: "https://cdn.jsdelivr.net/npm/simple-icons@16.37.0/icons/warp.svg",
        role: m.dailyToolTerminal(),
    },
    {
        name: "Zed",
        href: "https://zed.dev",
        icon: "https://cdn.jsdelivr.net/npm/simple-icons@16.37.0/icons/zedindustries.svg",
        role: m.dailyToolEditor(),
    },
];

const rows = Array.from({ length: Math.ceil(tools.length / 2) }, (_, index) =>
    tools.slice(index * 2, index * 2 + 2),
);
---

<section transition:name="tools-section">
    <div class="mb-7 flex items-baseline justify-between gap-4">
        <h2
            class="text-3xl font-bold md:text-5xl"
            transition:name="tools-title"
        >
            {m.dailyTools()}
        </h2>
        <span
            class="ui text-[11px] font-semibold uppercase tracking-[0.16em] text-muted-foreground dark:text-gray-400"
            aria-hidden="true"
        >
            {String(tools.length).padStart(2, "0")}
        </span>
    </div>

    <div class="border-t border-border">
        {
            rows.map((row) => (
                <div class="grid grid-cols-1 border-b border-border sm:grid-cols-2 sm:gap-x-10">
                    {row.map((tool) => (
                        <a
                            href={tool.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group grid min-h-[62px] grid-cols-[20px_minmax(0,1fr)_14px] items-center gap-x-3 border-b border-border py-3.5 transition-colors last:border-b-0 hover:text-blue-600 dark:hover:text-blue-400 sm:min-h-[72px] sm:grid-cols-[24px_minmax(0,1fr)_14px] sm:border-b-0"
                        >
                            <img
                                src={tool.icon}
                                alt=""
                                data-ui-icon
                                width="24"
                                height="24"
                                loading="lazy"
                                decoding="async"
                                class="h-[18px] w-[18px] shrink-0 object-contain opacity-80 grayscale transition-opacity group-hover:opacity-100 dark:invert sm:h-[22px] sm:w-[22px]"
                            />
                            <span class="flex min-w-0 flex-col gap-0.5">
                                <span class="text-md font-semibold leading-[1.2] sm:text-lg">
                                    {tool.name}
                                </span>
                                <span class="ui text-[11px] font-medium uppercase leading-[1.3] tracking-[0.1em] text-muted-foreground dark:text-gray-400">
                                    {tool.role}
                                </span>
                            </span>
                            <svg
                                class="h-3 w-3 text-muted-foreground transition-colors group-hover:text-blue-600 dark:text-gray-400 dark:group-hover:text-blue-400"
                                viewBox="0 0 16 16"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.4"
                                aria-hidden="true"
                            >
                                <path d="M4 12 12 4M6 4h6v6"></path>
                            </svg>
                        </a>
                    ))}
                    {row.length === 1 && (
                        <div class="hidden sm:block" aria-hidden="true"></div>
                    )}
                </div>
            ))
        }
    </div>
</section>

<style>
    .ui {
        font-family: "Inter Variable", Inter, sans-serif;
    }
</style>
