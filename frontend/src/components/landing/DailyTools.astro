---
import * as m from "@paraglide/messages.js";
import ToolIcons from "./ToolIcons.astro";

const tools = [
    {
        name: "DeepSeek Harness",
        href: "https://github.com/deepseek-ai/deepseek-harness",
        icon: "tool-deepseek",
        role: m.dailyToolAgentHarness(),
    },
    {
        name: "Claude Code Desktop",
        href: "https://code.claude.com/docs/en/desktop-quickstart",
        icon: "tool-claude",
        role: m.dailyToolCodingAgent(),
    },
    {
        name: "Firefox",
        href: "https://www.mozilla.org/firefox/",
        icon: "tool-firefox",
        role: m.dailyToolBrowser(),
    },
    {
        name: "Bitwarden",
        href: "https://bitwarden.com",
        icon: "tool-bitwarden",
        role: m.dailyToolPasswords(),
    },
    {
        name: "Docker Desktop",
        href: "https://www.docker.com/products/docker-desktop/",
        icon: "tool-docker",
        role: m.dailyToolContainers(),
    },
    {
        name: "Warp",
        href: "https://www.warp.dev",
        icon: "tool-warp",
        role: m.dailyToolTerminal(),
    },
    {
        name: "Zed",
        href: "https://zed.dev",
        icon: "tool-zedindustries",
        role: m.dailyToolEditor(),
    },
    {
        name: "MacBook Pro 16",
        href: "https://www.apple.com/shop/buy-mac/macbook-pro/16-inch",
        icon: "tool-apple",
        role: m.dailyToolLaptop(),
    },
];

const rows = Array.from({ length: Math.ceil(tools.length / 2) }, (_, index) =>
    tools.slice(index * 2, index * 2 + 2),
);
---

<section transition:name="tools-section">
    <div class="mb-7 flex items-baseline justify-between gap-4">
        <h2
            class="text-3xl font-medium tracking-[-0.022em] md:text-5xl"
            transition:name="tools-title"
        >
            {m.dailyTools()}
        </h2>
        <span
            class="text-xs font-medium uppercase tracking-[0.12em] text-muted-foreground"
            aria-hidden="true"
        >
            {String(tools.length).padStart(2, "0")}
        </span>
    </div>

    <div class="border-t border-border">
        {
            rows.map((row) => (
                <div class="grid grid-cols-1 border-b border-border sm:grid-cols-2 sm:gap-x-10">
                    {row.map((tool) => (
                        <a
                            href={tool.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group grid min-h-[62px] grid-cols-[20px_minmax(0,1fr)_14px] items-center gap-x-3 border-b border-border py-3.5 transition-colors last:border-b-0 hover:bg-muted/40 active:bg-muted/60 sm:min-h-[72px] sm:grid-cols-[24px_minmax(0,1fr)_14px] sm:border-b-0"
                        >
                            <svg
                                data-ui-icon
                                class="h-[18px] w-[18px] shrink-0 text-foreground opacity-80 transition-opacity group-hover:opacity-100 sm:h-[22px] sm:w-[22px]"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <use href={`#${tool.icon}`}></use>
                            </svg>
                            <span class="flex min-w-0 flex-col gap-0.5">
                                <span class="text-md font-medium leading-[1.3] tracking-[-0.01em] text-foreground sm:text-lg">
                                    {tool.name}
                                </span>
                                <span class="text-xs font-medium uppercase leading-[1.3] tracking-[0.08em] text-muted-foreground">
                                    {tool.role}
                                </span>
                            </span>
                            <svg
                                class="h-3 w-3 text-muted-foreground transition-colors group-hover:text-foreground"
                                viewBox="0 0 16 16"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.4"
                                aria-hidden="true"
                            >
                                <path d="M4 12 12 4M6 4h6v6"></path>
                            </svg>
                        </a>
                    ))}
                    {row.length === 1 && (
                        <div class="hidden sm:block" aria-hidden="true"></div>
                    )}
                </div>
            ))
        }
    </div>
</section>

<ToolIcons />
