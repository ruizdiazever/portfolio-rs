---
import { getLocale } from "@paraglide/runtime";

const words =
    getLocale() === "zh"
        ? [
              "Rust 开发者",
              "设计爱好者",
              "开发者",
              "软件工程师",
              "企业家",
              "创始人",
          ]
        : [
              "Rust Developer",
              "Design Enthusiast",
              "Dev",
              "Software Engineer",
          ];
---

<span
    class="inline-block transition-opacity duration-150"
    data-word-animation
    data-words={JSON.stringify(words)}
>{words[0]}</span>

<script>
    const element = document.querySelector<HTMLElement>("[data-word-animation]");
    if (element) {
        const words = JSON.parse(element.dataset.words ?? "[]") as string[];
        const reduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        if (!reduced && words.length > 1) {
            let index = 0;
            window.setInterval(() => {
                index = (index + 1) % words.length;
                element.classList.add("opacity-0");
                window.setTimeout(() => {
                    element.textContent = words[index];
                    element.classList.remove("opacity-0");
                }, 150);
            }, 10_000);
        }
    }
</script>
