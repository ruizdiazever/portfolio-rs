---
import Layout from "$lib/layouts/Layout.astro";
import * as m from "@paraglide/messages.js";

Astro.response.status = 404;
const defaultTitle = m.notFoundTitle();

const { message = defaultTitle } = Astro.props as { message: string };
---

<Layout
    description={`404 · ${defaultTitle}`}
    title={defaultTitle}
    showFooter={false}
    showHeader={false}
>
    <section class="grid place-content-center h-screen gap-3 text-center">
        <span class="text-6xl font-medium tracking-[-0.022em] text-foreground">404</span>
        <h1 class="text-2xl font-medium tracking-[-0.012em]">{message}</h1>
        <p class="max-w-[40ch] text-md text-muted-foreground">
            {m.notFoundBody()}
        </p>
        <a href="/" class="mt-4 font-medium text-foreground">
            {m.goHome()}
            <span aria-hidden="true"> &rarr;</span>
        </a>
    </section>
</Layout>
