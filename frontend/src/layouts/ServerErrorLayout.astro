---
import Layout from "$lib/layouts/Layout.astro";
import * as m from "@paraglide/messages.js";

Astro.response.status = 500;
const defaultTitle = m.serverErrorTitle();
---

<Layout
    description={`500 — ${defaultTitle}`}
    title={defaultTitle}
    showFooter={false}
    showHeader={false}
>
    <section class="grid place-content-center h-screen space-y-4">
        <h1 class="mt-4 text-4xl font-semibold text-center">{defaultTitle}</h1>
        <p
            class="max-w-[40ch] text-lg text-center text-balance text-muted-foreground"
        >
            {m.serverErrorBody()}
        </p>
        <a href="/" class="mt-6 font-semibold">
            {m.goHome()}
            <span aria-hidden="true"> &rarr;</span>
        </a>
    </section>
</Layout>
