---
import { Font } from "astro:assets";
import { getLocale } from "@paraglide/runtime";
import Footer from "$lib/components/common/Footer.astro";
import Header from "$lib/components/common/Header.astro";
import SEO from "$lib/components/common/SEO.astro";
import MachineView from "$lib/components/common/MachineView.astro";
import * as m from "@paraglide/messages.js";
import "$lib/styles/app.css";
import type { ArticleMeta, FaqEntry, ProjectMeta } from "$lib/common/schema";

interface Props {
    description?: string;
    title: string;
    preloadImgLCP?: string;
    canonical?: string;
    image?: string;
    isHomePage?: boolean;
    showHeader?: boolean;
    showFooter?: boolean;
    maxWithMd?: boolean;
    pageType?: string;
    article?: ArticleMeta;
    faq?: FaqEntry[];
    project?: ProjectMeta;
}
const {
    title,
    description,
    preloadImgLCP,
    canonical,
    image,
    showHeader = true,
    showFooter = true,
    maxWithMd = true,
    pageType,
    article,
    faq,
    project,
} = Astro.props;
---

<!doctype html>
<html lang={getLocale()}>
    <head>
        <script is:inline>
            function loadAnalytics() {
                if (document.querySelector("script[data-plausible]")) return;
                const script = document.createElement("script");
                script.defer = true;
                script.dataset.plausible = "true";
                script.dataset.domain = "everdev.it";
                script.src = "https://plausible.berli.app/js/script.js";
                document.head.appendChild(script);
            }

            function scheduleAnalytics() {
                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadAnalytics, {
                        timeout: 3_000,
                    });
                } else {
                    window.setTimeout(loadAnalytics, 2_000);
                }
            }

            if (document.readyState === "complete") {
                scheduleAnalytics();
            } else {
                window.addEventListener("load", scheduleAnalytics, {
                    once: true,
                });
            }
        </script>
        <Font cssVariable="--font-inter" preload />
        <SEO
            title={title}
            description={description}
            preloadImgLCP={preloadImgLCP}
            canonical={canonical}
            image={image}
            pageType={pageType}
            article={article}
            faq={faq}
            project={project}
        />
        <script is:inline>
            (() => {
                const metas = document.querySelectorAll(
                    'meta[name="theme-color"]',
                );
                if (!metas.length) return;

                const sync = () => {
                    const root = document.documentElement;
                    const color =
                        root.dataset.view === "machine" ||
                        root.classList.contains("dark")
                            ? "#08090a"
                            : "#ffffff";
                    metas.forEach((meta) =>
                        meta.setAttribute("content", color),
                    );
                };

                sync();
                window
                    .matchMedia("(prefers-color-scheme: dark)")
                    .addEventListener("change", sync);
                new MutationObserver(sync).observe(
                    document.documentElement,
                    { attributes: true, attributeFilter: ["class"] },
                );
            })();
        </script>
        <script is:inline>
            (() => {
                const root = document.documentElement;
                const url = new URL(window.location.href);
                const params = url.searchParams;
                const legacyAgent = params.get("mode") === "agent";
                const query = params.get("view");
                const legacyHuman =
                    params.get("mode") === "human" && !query;
                const key = "portfolio-view";
                const oldKey = "portfolio-agent-mode";

                let stored = null;
                try {
                    stored = localStorage.getItem(key);
                    if (stored !== "machine" && stored !== "human") {
                        const previous = localStorage.getItem(oldKey);
                        if (previous === "agent") stored = "machine";
                        else if (previous === "human") stored = "human";
                    }
                } catch {}

                const machine =
                    legacyAgent ||
                    query === "machine" ||
                    (!legacyHuman &&
                        query !== "human" &&
                        stored === "machine");
                const fromUrl = legacyAgent || query === "machine";

                if (machine) {
                    root.setAttribute("data-view", "machine");
                    root.classList.add("dark");

                    const scheme = document.querySelector(
                        'meta[name="color-scheme"]',
                    );
                    if (scheme) scheme.setAttribute("content", "dark");

                    const reduce = window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches;
                    if (fromUrl && !reduce) {
                        root.classList.add("machine-intro");
                        window.setTimeout(
                            () => root.classList.remove("machine-intro"),
                            4_000,
                        );
                    }
                } else {
                    root.removeAttribute("data-view");
                }

                if (legacyAgent) {
                    params.delete("mode");
                    params.set("view", "machine");
                } else if (legacyHuman) {
                    params.delete("mode");
                    params.delete("view");
                } else if (query === "human") {
                    params.delete("view");
                }
                params.delete("mode");

                if (
                    legacyAgent ||
                    legacyHuman ||
                    query === "machine" ||
                    query === "human"
                ) {
                    try {
                        localStorage.setItem(
                            key,
                            machine ? "machine" : "human",
                        );
                        localStorage.removeItem(oldKey);
                    } catch {}
                    const search = params.toString();
                    window.history.replaceState(
                        null,
                        "",
                        `${url.pathname}${search ? `?${search}` : ""}${url.hash}`,
                    );
                } else if (stored === "machine" || stored === "human") {
                    try {
                        localStorage.setItem(key, stored);
                        localStorage.removeItem(oldKey);
                    } catch {}
                }
            })();
        </script>
    </head>
    <body class="bg-background mx-auto overflow-y-scroll">
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:border focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-foreground"
        >
            {m.skipToContent()}
        </a>
        {showHeader && <Header wide={!maxWithMd} />}
        <main
            id="main"
            tabindex="-1"
            class={`flex flex-col px-4 sm:px-6 lg:px-8 overflow-x-clip flex-1 justify-center mx-auto gap-4 antialiased ${maxWithMd ? "max-w-(--breakpoint-md)" : ""}`}
        >
            <div class="human-view flex w-full flex-col gap-4">
                <slot />
            </div>
            <MachineView />
        </main>
        {showFooter && <Footer wide={!maxWithMd} />}
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
