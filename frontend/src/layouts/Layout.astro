---
import { Font } from "astro:assets";
import { getLocale } from "@paraglide/runtime";
import Footer from "$lib/components/common/Footer.astro";
import Header from "$lib/components/common/Header.astro";
import SEO from "$lib/components/common/SEO.astro";
import AgentDock from "$lib/components/common/AgentDock.astro";
import * as m from "@paraglide/messages.js";
import "$lib/styles/app.css";

interface Props {
    description?: string;
    title: string;
    preloadImgLCP?: string;
    canonical?: string;
    image?: string;
    isHomePage?: boolean;
    showHeader?: boolean;
    showFooter?: boolean;
    maxWithMd?: boolean;
}
const {
    title,
    description,
    preloadImgLCP,
    canonical,
    image,
    showHeader = true,
    showFooter = true,
    maxWithMd = true,
} = Astro.props;
---

<!doctype html>
<html lang={getLocale()}>
    <head>
        <script is:inline>
            function loadAnalytics() {
                if (document.querySelector("script[data-plausible]")) return;
                const script = document.createElement("script");
                script.defer = true;
                script.dataset.plausible = "true";
                script.dataset.domain = "everdev.it";
                script.src = "https://plausible.berli.app/js/script.js";
                document.head.appendChild(script);
            }

            function scheduleAnalytics() {
                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadAnalytics, {
                        timeout: 3_000,
                    });
                } else {
                    window.setTimeout(loadAnalytics, 2_000);
                }
            }

            if (document.readyState === "complete") {
                scheduleAnalytics();
            } else {
                window.addEventListener("load", scheduleAnalytics, {
                    once: true,
                });
            }
        </script>
        <Font cssVariable="--font-inter" preload />
        <SEO
            title={title}
            description={description}
            preloadImgLCP={preloadImgLCP}
            canonical={canonical}
            image={image}
        />
        <script is:inline>
            (() => {
                const meta = document.querySelector('meta[name="theme-color"]');
                if (!meta) return;

                const sync = () => {
                    meta.setAttribute(
                        "content",
                        document.documentElement.classList.contains("dark")
                            ? "#08090a"
                            : "#ffffff",
                    );
                };

                sync();
                window
                    .matchMedia("(prefers-color-scheme: dark)")
                    .addEventListener("change", sync);
                new MutationObserver(sync).observe(
                    document.documentElement,
                    { attributes: true, attributeFilter: ["class"] },
                );
            })();
        </script>
        <script is:inline>
            (() => {
                const key = "portfolio-agent-mode";
                const query = new URLSearchParams(window.location.search).get("mode");
                let stored = null;
                try {
                    stored = localStorage.getItem(key);
                } catch {}
                const enabled =
                    query === "agent" ||
                    (query !== "human" && stored === "agent");
                document.documentElement.classList.toggle("agent-mode", enabled);
                if (query === "agent" || query === "human") {
                    try {
                        localStorage.setItem(key, query);
                    } catch {}
                }
            })();
        </script>
    </head>
    <body class="bg-background mx-auto overflow-y-scroll">
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:border focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-foreground"
        >
            {m.skipToContent()}
        </a>
        {showHeader && <Header wide={!maxWithMd} />}
        {showHeader && <AgentDock />}
        <main
            id="main"
            tabindex="-1"
            class={`flex flex-col px-4 sm:px-6 lg:px-8 overflow-x-clip flex-1 justify-center mx-auto gap-4 antialiased ${maxWithMd ? "max-w-(--breakpoint-md)" : ""}`}
        >
            <slot />
        </main>
        {showFooter && <Footer wide={!maxWithMd} />}
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
