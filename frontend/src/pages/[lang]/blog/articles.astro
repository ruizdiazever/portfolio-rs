---
import Layout from "$lib/layouts/Layout.astro";
import Blog from "$lib/components/landing/cards/Blog.astro";
import { getPosts } from "$lib/common/getPosts.ts";
import { getLocale } from "@paraglide/runtime";
import Divider from "$lib/components/common/Divider.astro";
import PageHeader from "$lib/components/common/PageHeader.astro";
import { getVisitRequest } from "$lib/common/getViews.ts";
import * as m from "@paraglide/messages.js";

const posts = getPosts();
const postViews = await Promise.all(
    posts.map((post) => getVisitRequest(post.id)),
);
---

<Layout
    title={m.titleWriting()}
    description={m.seoWriting()}
    pageType="CollectionPage"
>
    <div class="min-h-[60vh] pb-16">
        <PageHeader
            title={m.articles()}
            description={m.writingIntro()}
        >
            <a
                href={`/${getLocale()}/feed.xml`}
                rel="alternate"
                type="application/rss+xml"
                class="inline-flex text-md font-medium text-muted-foreground underline decoration-border underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground"
            >
                {m.rss()}
            </a>
        </PageHeader>
        <Divider />
        {
            posts
                .sort((a, b) => (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0))
                .map((post, index, filteredPosts) => {
                    const postView = postViews.find(
                        (view) => view.projectId === post.id,
                    );
                    return (
                        <>
                            <Blog
                                title={post.title[getLocale()]}
                                pinned={post.pinned}
                                url={`/${getLocale()}${post.url}`}
                                description={post.description[getLocale()]}
                                views={postView?.visits || 0}
                                tags={post.tags}
                                date={post.date}
                                headingLevel={2}
                            />
                            {index < filteredPosts.length - 1 && <Divider />}
                        </>
                    );
                })
        }
    </div>
</Layout>
