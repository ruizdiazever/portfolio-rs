{
  "name": "portfolio-ever",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "machine-translate": "inlang machine translate --project project.inlang",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:e2e:ci": "pnpm run build && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "media:build": "node scripts/sync-media.mjs",
    "media:sync": "node scripts/sync-media.mjs --upload"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.7",
    "@astrojs/mdx": "^8.1.4",
    "@astrojs/node": "^11.1.12",
    "@astrojs/svelte": "9.1.4",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@number-flow/svelte": "^0.4.2",
    "@tanstack/table-core": "^8.21.3",
    "astro": "^7.4.10",
    "astro-icon": "^1.2.0",
    "dayjs": "^1.11.23",
    "js-cookie": "^3.0.8",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype-class-names": "^2.0.0",
    "satori-astro": "^0.4.1",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inlang/cli": "^3.6.0",
    "@inlang/paraglide-js": "3.2.1",
    "@inlang/plugin-m-function-matcher": "2.4.3",
    "@inlang/plugin-message-format": "4.6.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.71.0",
    "@playform/compress": "0.2.5",
    "@playwright/test": "^1.65.0",
    "@shadcn-svelte/primitives": "^0.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-cookie": "^3.0.6",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.1.0",
    "layerchart": "^2.10.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "shiki": "^3.23.0",
    "svelte-sonner": "^1.2.3",
    "sveltekit-superforms": "^3.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "1.0.0-next.7"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "satori": "0.63.2"
    }
  },
  "packageManager": "pnpm@10.26.1"
}
